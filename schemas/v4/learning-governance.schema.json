{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"urn:promkes:v4:learning-governance:1.0.0",
 "title":"PROMKES learning, asset, drift, selection, preflight and process-outcome records",
 "type":"object","additionalProperties":false,
 "required":["schema_version","approved_formulas","drift_observations","accepted_model_baselines","selection_advice","outcome_records","preflight_records"],
 "properties":{
  "schema_version":{"const":"1.0.0"},
  "approved_formulas":{"type":"array","items":{"$ref":"#/$defs/formula"}},
  "drift_observations":{"type":"array","items":{"$ref":"#/$defs/observation"}},
  "accepted_model_baselines":{"type":"array","items":{"$ref":"#/$defs/baseline"}},
  "selection_advice":{"type":"array","items":{"$ref":"#/$defs/advice"}},
  "outcome_records":{"type":"array","items":{"$ref":"#/$defs/outcome"}},
  "preflight_records":{"type":"array","items":{"$ref":"#/$defs/preflight"}}
 },
 "$defs":{
  "formula":{"type":"object","additionalProperties":false,"required":["formula_id","title","formula_version","lifecycle_status","formula_body","content_sha256","provenance","rights_status","scope","model_binding","validation_runs","s12_qa","claim_refs"],
   "properties":{
    "formula_id":{"type":"string","pattern":"^AFL-[A-Z0-9-]+$"},"title":{"type":"string","minLength":1},"formula_version":{"type":"string","minLength":1},
    "lifecycle_status":{"enum":["DRAFT","CANDIDATE","REVIEWED","APPROVED","STALE","REVOKED"]},"formula_body":{"type":"string","minLength":1},"content_sha256":{"$ref":"#/$defs/hash"},
    "provenance":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["source_id","locator","source_type","observed_at"],"properties":{"source_id":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1},"source_type":{"enum":["OFFICIAL_DOCUMENTATION","OFFICIAL_RELEASE","USER_SUPPLIED","INTERNAL_ARTIFACT","EMPIRICAL_TEST","COMMUNITY_REFERENCE"]},"observed_at":{"type":"string","format":"date-time"},"source_version":{"type":["string","null"]},"content_sha256":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]}}}},
    "rights_status":{"enum":["CLEAR","RESTRICTED","UNKNOWN"]},
    "scope":{"type":"object","additionalProperties":false,"required":["task_types","audience_contexts","allowed_languages","exclusions"],"properties":{"task_types":{"type":"array","minItems":1,"items":{"type":"string"}},"audience_contexts":{"type":"array","minItems":1,"items":{"type":"string"}},"allowed_languages":{"type":"array","minItems":1,"items":{"type":"string"}},"exclusions":{"type":"array","items":{"type":"string"}}}},
    "model_binding":{"type":"object","additionalProperties":false,"required":["provider","model","model_version","binding_type"],"properties":{"provider":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"model_version":{"type":"string","minLength":1},"binding_type":{"enum":["EXACT_VERSION","PROVIDER_NEUTRAL"]}}},
    "validation_runs":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["test_id","status","tested_at","evidence_ref"],"properties":{"test_id":{"type":"string","minLength":1},"status":{"enum":["PASS","FAIL","NOT_RUN","NOT_VERIFIED","BLOCKED"]},"tested_at":{"type":["string","null"],"format":"date-time"},"environment":{"type":["string","null"]},"evidence_ref":{"type":["string","null"]}}}},
    "s12_qa":{"type":"object","additionalProperties":false,"required":["status","reviewer_ref","reviewed_at","evidence_ref"],"properties":{"status":{"enum":["PASS","FAIL","NOT_RUN","NOT_VERIFIED","BLOCKED"]},"reviewer_ref":{"type":["string","null"]},"reviewed_at":{"type":["string","null"],"format":"date-time"},"evidence_ref":{"type":["string","null"]}}},
    "claim_refs":{"type":"array","items":{"type":"string"}},
    "human_approval":{"type":["object","null"],"additionalProperties":false,"required":["approver_ref","authority_basis","approved_at","approved_content_sha256","decision"],"properties":{"approver_ref":{"type":"string","minLength":1},"authority_basis":{"type":"string","minLength":1},"approved_at":{"type":"string","format":"date-time"},"approved_content_sha256":{"$ref":"#/$defs/hash"},"decision":{"const":"APPROVE"}}}
   }},
  "hash":{"type":"string","pattern":"^sha256:[a-fA-F0-9]{64}$"},
  "observation":{"type":"object","additionalProperties":false,"required":["observation_id","provider","model","endpoint_id","endpoint_url","observed_at","fetch_status","normalizer_version","normalized_sha256","error_code","http_status"],"properties":{"observation_id":{"type":"string","pattern":"^MDS-[A-Z0-9-]+$"},"provider":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"endpoint_id":{"type":"string","minLength":1},"endpoint_url":{"type":"string","format":"uri"},"observed_at":{"type":"string","format":"date-time"},"fetch_status":{"enum":["SUCCESS","HTTP_ERROR","RATE_LIMITED","FETCH_ERROR","PARSE_ERROR","POLICY_BLOCKED","REDIRECT_BLOCKED"]},"normalizer_version":{"type":"string","minLength":1},"normalized_sha256":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"snapshot_ref":{"type":["string","null"]},"error_code":{"type":["string","null"]},"http_status":{"type":["integer","null"],"minimum":100,"maximum":599},"change_summary":{"type":["string","null"]}}},
  "baseline":{"type":"object","additionalProperties":false,"required":["baseline_id","provider","model","endpoint_id","endpoint_url","model_version","normalized_sha256","normalizer_version","accepted_at","reviewer_ref","evidence_ref","decision"],"properties":{"baseline_id":{"type":"string","pattern":"^BASE-[A-Z0-9-]+$"},"provider":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"endpoint_id":{"type":"string","minLength":1},"endpoint_url":{"type":"string","format":"uri"},"model_version":{"type":"string","minLength":1},"normalized_sha256":{"$ref":"#/$defs/hash"},"normalizer_version":{"type":"string","minLength":1},"accepted_at":{"type":"string","format":"date-time"},"reviewer_ref":{"type":"string","minLength":1},"evidence_ref":{"type":"string","minLength":1},"decision":{"const":"HUMAN_ACCEPTED"},"supersedes_baseline_id":{"type":["string","null"]}}},
  "advice":{"type":"object","additionalProperties":false,"required":["advice_id","created_at","task_type","advisory_only","candidates","tradeoffs","unknowns","selected_candidate_id","selection_actor"],"properties":{"advice_id":{"type":"string","pattern":"^MSA-[A-Z0-9-]+$"},"created_at":{"type":"string","format":"date-time"},"task_type":{"type":"string","minLength":1},"advisory_only":{"const":true},"candidates":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["candidate_id","provider","model","model_version","feature_evidence","tradeoff"],"properties":{"candidate_id":{"type":"string"},"provider":{"type":"string"},"model":{"type":"string"},"model_version":{"type":"string"},"feature_evidence":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["feature","status","evidence_ref"],"properties":{"feature":{"type":"string"},"status":{"enum":["DOCS_VERIFIED","RUNTIME_TESTED","UNKNOWN","NOT_CHECKED","STALE","BLOCKED"]},"evidence_ref":{"type":["string","null"]}}}},"tradeoff":{"type":"string"}}}},"tradeoffs":{"type":"array","items":{"type":"string"}},"unknowns":{"type":"array","items":{"type":"string"}},"selected_candidate_id":{"type":["string","null"]},"selection_actor":{"enum":["USER","PROJECT_OWNER",null]}}},
  "outcome":{"type":"object","additionalProperties":false,"required":["outcome_id","metric","data_scope","cohort_ref","window_start","window_end","numerator","denominator","value","unit","missing_count","evidence_ref","limitations"],"properties":{"outcome_id":{"type":"string","pattern":"^POR-[A-Z0-9-]+$"},"metric":{"enum":["CYCLE_TIME","REVIEWER_EFFORT","REWORK_RATE","FIRST_PASS_ACCEPTANCE","APPROVED_REUSE_RATE","STALE_EVIDENCE_DETECTION_LATENCY","TRACE_COMPLETENESS","RISK_MISCLASSIFICATION","QA_ESCAPE_COUNT"]},"data_scope":{"const":"PROCESS_ONLY"},"cohort_ref":{"type":"string"},"window_start":{"type":"string","format":"date-time"},"window_end":{"type":"string","format":"date-time"},"numerator":{"type":"number","minimum":0},"denominator":{"type":"number","minimum":0},"value":{"type":["number","null"]},"unit":{"type":"string"},"missing_count":{"type":"integer","minimum":0},"evidence_ref":{"type":["string","null"]},"limitations":{"type":"array","items":{"type":"string"}}}},
  "preflight":{"type":"object","additionalProperties":false,"required":["preflight_id","declared_risk_lane","material_unknown","critical_trigger","s14_status","s02_disposition","route_depth","fast_track"],"properties":{"preflight_id":{"type":"string","pattern":"^RPF-[A-Z0-9-]+$"},"declared_risk_lane":{"enum":["R0","R1","R2","R3","UNKNOWN"]},"material_unknown":{"type":"boolean"},"critical_trigger":{"type":"boolean"},"s14_status":{"enum":["COMPLETE","PARTIAL","NOT_RUN","NOT_VERIFIED","BLOCKED"]},"s02_disposition":{"enum":["NO_MATERIAL_HEALTH_CLAIM","FACT_LOCKED","HOLD","NOT_APPLICABLE",null]},"route_depth":{"enum":["COMPACT","STANDARD","FULL","STOP_AND_ESCALATE","BLOCKED"]},"fast_track":{"const":false},"rationale":{"type":"array","items":{"type":"string"}}}}
 }
}