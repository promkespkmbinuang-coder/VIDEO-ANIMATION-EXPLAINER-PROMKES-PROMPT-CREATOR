{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:promkes:v4:motion-record:2.0.0",
  "title": "Renderer-neutral Motion Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "element_id",
    "scene_id",
    "fps",
    "timebase",
    "position_unit",
    "scale_unit",
    "rotation_unit",
    "start_frame",
    "end_frame",
    "keyframes",
    "state_in",
    "state_out",
    "reduced_motion_fallback"
  ],
  "properties": {
    "element_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "timebase": {
      "enum": [
        "FRAMES",
        "SECONDS"
      ]
    },
    "position_unit": {
      "enum": [
        "px",
        "%",
        "normalized"
      ]
    },
    "scale_unit": {
      "enum": [
        "ratio",
        "%"
      ]
    },
    "rotation_unit": {
      "enum": [
        "deg",
        "rad"
      ]
    },
    "start_frame": {
      "type": "integer",
      "minimum": 0
    },
    "end_frame": {
      "type": "integer",
      "minimum": 1
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "at",
          "easing",
          "value"
        ],
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0
          },
          "easing": {
            "type": "string"
          },
          "value": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "state_in": {
      "type": "object"
    },
    "state_out": {
      "type": "object"
    },
    "reduced_motion_fallback": {
      "type": "string",
      "minLength": 1
    }
  }
}
