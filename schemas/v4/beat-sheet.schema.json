{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Promkes Beat Sheet V4.1.8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "beat_sheet_id",
    "version",
    "status",
    "beats"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "beat_sheet_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "4.1.8"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PARTIAL",
        "READY_FOR_QA",
        "BLOCKED"
      ]
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beat_id",
          "sequence",
          "time_in",
          "time_out",
          "timing_precision",
          "narrative_function",
          "scene_id",
          "shot_id",
          "motion_refs",
          "audio_refs",
          "overlay_refs",
          "qa_oracle"
        ],
        "properties": {
          "beat_id": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "time_in": {
            "type": "number",
            "minimum": 0
          },
          "time_out": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "timing_precision": {
            "enum": [
              "EXACT_AUDIO",
              "SOURCE_TIMECODE",
              "ESTIMATED",
              "UNSPECIFIED"
            ]
          },
          "timing_source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_frame": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "end_frame_exclusive": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "narrative_function": {
            "type": "string",
            "minLength": 1
          },
          "message_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claim_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "camera_plan_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "motion_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "element_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "audio_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "overlay_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transition_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mcg_state_in": {
            "type": [
              "string",
              "null"
            ]
          },
          "mcg_state_out": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessibility_fallback": {
            "type": "string",
            "minLength": 1
          },
          "qa_oracle": {
            "type": "string",
            "minLength": 1
          },
          "not_applicable_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
