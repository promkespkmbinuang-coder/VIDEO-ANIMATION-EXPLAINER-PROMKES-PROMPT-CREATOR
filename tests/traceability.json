{
  "schema_version": "1.0.0",
  "description": "One-to-one machine-readable traceability join for acceptance case IDs.",
  "requirements": [
    {
      "requirement_id": "REQ-01",
      "title": "Source fidelity and provenance",
      "statement": "Capture source facts, preserve conflicts and avoid guessing unreadable material."
    },
    {
      "requirement_id": "REQ-02",
      "title": "Health evidence integrity",
      "statement": "Keep medical claims status-labelled, sourced, scoped and human-reviewable."
    },
    {
      "requirement_id": "REQ-03",
      "title": "Audience and campaign objective",
      "statement": "Keep audience, behavior, message and CTA focused and ethically framed."
    },
    {
      "requirement_id": "REQ-04",
      "title": "Narrative, voice and timing integrity",
      "statement": "Keep script, VO, motion timing and total duration coherent."
    },
    {
      "requirement_id": "REQ-05",
      "title": "Visual identity and continuity",
      "statement": "Preserve character, setting, props, visual canon, Guide versions and change impact."
    },
    {
      "requirement_id": "REQ-06",
      "title": "Storyboard and motion reference",
      "statement": "Keep shot/composition and motion/time references structured and linked."
    },
    {
      "requirement_id": "REQ-07",
      "title": "Still/reference prompt engineering",
      "statement": "Create still/reference prompts and respect model capability limits."
    },
    {
      "requirement_id": "REQ-08",
      "title": "Exact text, accessibility and distribution",
      "statement": "Separate exact overlay/subtitle text from generated imagery and protect accessibility."
    },
    {
      "requirement_id": "REQ-09",
      "title": "Renderer-neutral handoff",
      "statement": "Provide traceable scene, asset, layer, time and audio mappings without assuming executable renderer code."
    },
    {
      "requirement_id": "REQ-10",
      "title": "QA, authority and release governance",
      "statement": "Maintain independent QA, defect routing, rights and human approval gates."
    },
    {
      "requirement_id": "NFR-01",
      "title": "Portability",
      "statement": "Keep canonical skills portable and host compatibility evidence-specific."
    },
    {
      "requirement_id": "NFR-02",
      "title": "Traceability and version control",
      "statement": "Trace requirement, test, owner, dependency, output, Guide version and change impact."
    },
    {
      "requirement_id": "NFR-03",
      "title": "Reliability and recovery",
      "statement": "Represent unknowns, partial output, blocked dependencies and unresolved defects accurately."
    },
    {
      "requirement_id": "REQ-REF-01",
      "title": "Reference-only output boundary",
      "statement": "Return still/reference prompts and structured references, not text-to-video or rendered video."
    },
    {
      "requirement_id": "REQ-REF-02",
      "title": "Guide-linked visual references",
      "statement": "Link style, character, environment and prop references to canonical Guide IDs/versions."
    },
    {
      "requirement_id": "REQ-REF-03",
      "title": "Scene keyframe reference",
      "statement": "Create still keyframe references tied to storyboard/shot IDs."
    },
    {
      "requirement_id": "REQ-REF-04",
      "title": "Motion/image prompt separation",
      "statement": "Keep motion and timing data separate from still-image prompts."
    },
    {
      "requirement_id": "REQ-REF-05",
      "title": "Exact overlay source control",
      "statement": "Preserve dates, health wording, institution, logo and CTA as separate exact overlay data."
    },
    {
      "requirement_id": "REQ-REF-06",
      "title": "Reference asset lifecycle",
      "statement": "Distinguish prompt draft, generated, selected and approved asset states."
    },
    {
      "requirement_id": "REQ-REF-07",
      "title": "Renderer-neutral scene handoff",
      "statement": "Map scenes to asset IDs, layers, timing, overlays, subtitles and audio cues."
    },
    {
      "requirement_id": "REQ-REF-08",
      "title": "Remotion implementation boundary",
      "statement": "Do not assume generic handoff is executable Remotion props or output TSX by default."
    },
    {
      "requirement_id": "REQ-REF-09",
      "title": "Artifact QA evidence gate",
      "statement": "Do not claim render QA without actual artifact and reviewer evidence."
    },
    {
      "requirement_id": "REQ-11",
      "title": "Canonical MCG and single-owner Guide integration",
      "statement": "Maintain one canonical MCG manifest, exactly seven modular Guides and three protocols with one primary owner per Guide and traceable versions."
    },
    {
      "requirement_id": "REQ-12",
      "title": "Post-storyboard continuity and adaptive scene state",
      "statement": "Refresh S13 Scene Continuity after storyboard plus S07/S09/S10 inputs and before S08; enforce immutable, controlled-variation and scene-dependent attributes."
    }
  ],
  "outputs": [
    {
      "output_id": "OUT-SOURCE-DOSSIER",
      "description": "Source dossier and provenance records"
    },
    {
      "output_id": "OUT-HEALTH-TRUTH-REGISTRY",
      "description": "Health Truth Registry and fact locks"
    },
    {
      "output_id": "OUT-CAMPAIGN-BRIEF",
      "description": "Audience, behavior, key message and CTA brief"
    },
    {
      "output_id": "OUT-SCREENPLAY-VO",
      "description": "Screenplay, dialogue, VO and timing sheet"
    },
    {
      "output_id": "OUT-VISUAL-GUIDES",
      "description": "Canonical visual style and character references"
    },
    {
      "output_id": "OUT-STORYBOARD",
      "description": "Storyboard, shot list and framing reference"
    },
    {
      "output_id": "OUT-MOTION-REFERENCE",
      "description": "Motion state, path, transform and timing reference"
    },
    {
      "output_id": "OUT-REFERENCE-PROMPTS",
      "description": "Still/reference prompts for each asset class"
    },
    {
      "output_id": "OUT-REFERENCE-ASSET-MANIFEST",
      "description": "Reference Asset Manifest and lifecycle states"
    },
    {
      "output_id": "OUT-AUDIO-REFERENCE",
      "description": "Voice, music direction and sound cue references"
    },
    {
      "output_id": "OUT-OVERLAY-SUBTITLE-DATA",
      "description": "Exact overlays, logo/text data and subtitle records"
    },
    {
      "output_id": "OUT-RENDERER-HANDOFF",
      "description": "Renderer-neutral scene/layer/timing/asset handoff"
    },
    {
      "output_id": "OUT-DISTRIBUTION-PACKAGE",
      "description": "Accessibility and social distribution package"
    },
    {
      "output_id": "OUT-CONTINUITY-MCG",
      "description": "MCG index, seven Guide references and lock ledger"
    },
    {
      "output_id": "OUT-QA-REPORT",
      "description": "QA findings, defect routes and release disposition"
    },
    {
      "output_id": "OUT-TEST-TRACEABILITY",
      "description": "Requirement/test/owner/dependency/output traceability"
    },
    {
      "output_id": "OUT-PACKAGE-VALIDATION",
      "description": "Static package validation summary"
    },
    {
      "output_id": "OUT-HUMAN-APPROVAL",
      "description": "Named-role review and human approval record"
    }
  ],
